{
    "configurations": [
        {
            "name": "AVR-GCC",
            "includePath": [
                "${workspaceFolder}/**"
            ],
            "defines": [
                "__AVR_ATmega328P__",
                "F_CPU=16000000UL"
            ],
            "compilerPath": "C:/AVR/avr8-gnu-toolchain-win32_x86_64/bin/avr-gcc.exe",
            "compilerArgs": [
                "-mmcu=atmega328p"
            ],
            "cStandard": "gnu11",
            "cppStandard": "gnu++14",
            "intelliSenseMode": "gcc-x86"
        }
    ],
    "version": 4
}